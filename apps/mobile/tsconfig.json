{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.tsx", "../../src/**/*.ts"],
  "exclude": [
    "node_modules",
    "../../src/index.ts",
    "../../src/persistence/sqlite/nodeDriver.ts",
    "../../src/persistence/sqlite/nodeDatabase.ts"
  ]
}
